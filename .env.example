# 사이트 주소 (공유 링크·미리보기 이미지의 기준 주소). 배포 후 실제 도메인으로 바꾸세요.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 토스페이먼츠 결제위젯 키 ──────────────────────────────────────────
# 아래 값은 토스페이먼츠 문서에 공개된 "테스트 키"입니다. 실제 돈이 빠져나가지 않습니다.
# 실결제 전환: 토스페이먼츠 가맹 계약 후 개발자센터의 live_gck_ / live_gsk_ 키로 교체.
TOSS_CLIENT_KEY=test_gck_docs_Ovk5rk1EwkEbP0W43n07xlzm
TOSS_SECRET_KEY=test_gsk_docs_OaPz8L5KdmQXkzRz3y47BMw6

# 결제 완료 후 발급하는 "잠금 해제 토큰" 서명용 비밀값. 반드시 길고 무작위한 값으로 바꾸세요.
#   생성 예: openssl rand -hex 32
UNLOCK_SECRET=change-me-to-a-long-random-string

# 로컬 개발 전용: mock 으로 두면 토스 없이 "테스트 결제" 버튼으로 흐름을 확인합니다.
# 프로덕션(NODE_ENV=production)에서는 무시됩니다.
PAYMENT_MODE=

# AI 사진 관상 풀이용 Anthropic API 키 (https://console.anthropic.com 에서 발급).
# 비워두면 관상 유료 리포트는 사진 없이 만드는 기본 풀이로 대신합니다.
ANTHROPIC_API_KEY=

# (선택) 카카오 JavaScript 키. 넣으면 카카오톡 공유 버튼이 카카오 SDK의 카드형 공유로 동작합니다.
# 비워두면 휴대폰 기본 공유 시트 / 링크 복사로 동작합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=
